# Salin ke .env.local lalu isi. Jangan commit .env.local.
# Lokal: nilai dari `npx supabase status`. Cloud: Dashboard > Project Settings > API Keys.

NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) atau anon key lama. Aman untuk browser (dilindungi RLS).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) atau service_role lama. SERVER ONLY, hanya dipakai di src/lib/supabase/admin.ts.
SUPABASE_SECRET_KEY=
